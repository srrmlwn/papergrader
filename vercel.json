{
  "functions": {
    "api/grade.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "papergrader-alpha.vercel.app"
        }
      ],
      "destination": "https://www.gradethis.app/:path*",
      "permanent": true
    }
  ]
}
